# ---------------------------------------------------------------
# Repository-wide ignore rules.
#
# This file lives at the repo root and is the single source of
# truth for what git should never track. Do not add nested
# .gitignore files -- one authoritative copy is easier to review
# and cannot be silently deleted in a bad merge.
# ---------------------------------------------------------------

# Dependencies -- regenerated by `npm install`, never committed.
# These contain platform-specific native binaries (e.g. .node
# files built for linux-x64 vs darwin-arm64), so committing them
# actively breaks teammates on other operating systems.
node_modules/

# Build output -- regenerated by `npm run build`.
dist/
dist-ssr/
build/

# Secrets and local configuration.
# `.env.example` is the committed template and is explicitly
# re-included below. Every other .env file holds real credentials
# and must stay on the machine that created it.
.env
.env.*
!.env.example
*.local
# Claude Code personal settings (hooks, permissions) -- per-machine,
# never shared. Shared team settings go in .claude/settings.json.
.claude/settings.local.json

# Supabase CLI local state.
supabase/.branches/
supabase/.temp/
supabase/.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.nyc_output/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS / Windows filesystem cruft
.DS_Store
Thumbs.db
